<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Example/UI/InventoryStyleSheet.uss?fileID=7433441132597879392&amp;guid=469c8a63f9ba076c886256eb370c85c5&amp;type=3#InventoryStyleSheet"/>
    <ui:VisualElement name="MainPanel" style="flex-grow: 1; align-items: center; justify-content: center;">
        <ui:ListView name="ItemsListView" virtualization-method="DynamicHeight" style="position: relative; height: 610px; width: 950px;"/>
        <ui:VisualElement name="ButtonContainer" style="flex-grow: 0; position: relative; width: 750px; top: auto; left: auto; height: 75px; margin-top: 25px; flex-direction: row; justify-content: center; align-content: auto;">
            <ui:Button text="Add" name="AddButton" class="fancy-button" style="flex-grow: 1;"/>
            <ui:Button text="Remove" name="RemoveButton" class="fancy-button" style="flex-grow: 1;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
